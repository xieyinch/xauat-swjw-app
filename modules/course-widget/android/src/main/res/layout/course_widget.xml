<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/course_widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="课表"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="本周课表"
        android:textColor="#E8FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/col_l_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/col_l_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="无课"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/col_l_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_l_c1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_l_s1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/col_l_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_l_c2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_l_s2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/col_l_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_l_c3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_l_s3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:background="#2EFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/col_r_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="明天"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/col_r_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="无课"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/col_r_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_r_c1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_r_s1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/col_r_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_r_c2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_r_s2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/col_r_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/col_r_c3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课程"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/col_r_s3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地点"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
